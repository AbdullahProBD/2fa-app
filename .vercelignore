# ============================================================
# 2FA Vault — Vercel upload filter
# ============================================================
# IMPORTANT: when this file exists, Vercel IGNORES .gitignore.
# That means anything listed in .gitignore is NOT automatically
# excluded here — every entry has to be repeated below. Forgetting
# node_modules/dist would upload ~140 MB on every deploy.
#
# The build only needs: package.json, package-lock.json, .npmrc,
# index.html, vite.config.js, vercel.json, src/, public/,
# server/ and api/.
# ============================================================

# ── Dependencies (Vercel runs `npm ci` itself) ────────────────
node_modules
.pnpm-store

# ── Build output (regenerated by `npm run build`) ─────────────
dist
build
.vercel

# ── Tests (not part of the production runtime) ────────────────
tests
coverage
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx

# ── Secrets: env vars come from the Vercel dashboard ──────────
.env
.env.*
!.env.example

# ── Local tooling / agent worktrees ──────────────────────────
.kilo
.claude
.cursor
.github
.vscode
.idea

# ── Docs & meta (irrelevant to the built output) ─────────────
README.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
supabase-schema.sql

# ── Misc ──────────────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.netlify
