# =============================================================
# 2FA Vault — Environment Variables
#
# Copy this file to .env and fill in values before running.
# Generate SESSION_SECRET with: openssl rand -hex 32
# =============================================================

# ── Server ────────────────────────────────────────────────────
# Port for the Express server (default: 3001 in dev)
PORT=3001

# ── Session ───────────────────────────────────────────────────
# REQUIRED: Must be at least 32 random characters.
# ⚠️  App will refuse to start without this.
SESSION_SECRET=

# ── Admin credentials ─────────────────────────────────────────
# REQUIRED: The single admin account for this vault.
# ADMIN_PASS must be 16-256 characters. The first login only succeeds with
# exactly this password, and it becomes the vault password.
# The first successful login bootstraps the user row in Supabase.
ADMIN_USER=
ADMIN_PASS=

# ── Supabase ──────────────────────────────────────────────────
# REQUIRED: Get these from https://app.supabase.com
#   Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Optional: Comma-separated list of origins allowed to call the API.
# When empty, only same-origin requests are accepted (recommended).
# Example: ALLOWED_ORIGINS=https://2fa.example.com,https://www.example.com
ALLOWED_ORIGINS=

# ── Reverse proxy ─────────────────────────────────────────────
# Number of trusted proxy hops in front of the server, used so the login rate
# limit sees real client IPs. Leave empty when exposed directly to the internet
# (trusting X-Forwarded-For there would let clients spoof their IP). On Vercel
# it is set to 1 automatically.
TRUST_PROXY=
